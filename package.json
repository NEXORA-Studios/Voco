{
    "name": "voco",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "build.desktop": "turbo run build --filter=@nexora-studios/voco-desktop --filter=@nexora-studios/voco-frontend",
        "build.website": "turbo run build --filter=@nexora-studios/voco-website",
        "dev": "turbo run dev",
        "dev.desktop": "turbo run dev --filter=@nexora-studios/voco-desktop --filter=@nexora-studios/voco-frontend",
        "dev.website": "turbo run dev --filter=@nexora-studios/voco-website",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "turbo": "^2.10.13",
        "typescript": "5.9.3"
    },
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@tauri-apps/cli": "2.10.1"
    }
}
