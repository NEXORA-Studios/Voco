{
    "$schema": "https://v2-9-6.turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*", "target/**"],
            "outputs": ["target/release/bundle/**"],
            "env": [
                "TAURI_SIGNING_PRIVATE_KEY",
                "TAURI_SIGNING_PRIVATE_KEY_PASSWORD",
                "APPLE_CERTIFICATE",
                "APPLE_CERTIFICATE_PASSWORD",
                "APPLE_API_KEY",
                "APPLE_API_ISSUER",
                "APPLE_API_KEY_PATH"
            ]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "format": {
            "dependsOn": ["^format"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "w:dev": {
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"],
            "cache": false
        },
        "dev": {
            "dependsOn": ["w:dev"],
            "inputs": ["$TURBO_DEFAULT$", ".env*", "target/**"],
            "cache": false
        }
    }
}

